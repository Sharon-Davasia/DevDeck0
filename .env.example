# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite location (local-first default). Relative paths resolve from server/.
DATABASE_URL=./server/data/devdeck.db

# REQUIRED in production. Used to sign JWTs and derive the secret-encryption key.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list, or * for any origin.
CORS_ORIGIN=*

LOG_LEVEL=info
SEED_DEMO=true

# ─── Command execution ───────────────────────────────────────────────────────
# DevDeck only runs commands whose binary appears in the allowlist.
ENABLE_COMMAND_EXECUTION=true
COMMAND_REQUIRE_ALLOWLIST=true
COMMAND_TIMEOUT_MS=20000
COMMAND_MAX_OUTPUT_BYTES=262144

# ─── Docker ──────────────────────────────────────────────────────────────────
DOCKER_ENABLED=true
DOCKER_HOST=unix:///var/run/docker.sock

# ─── GitHub (optional, per-user tokens are stored encrypted) ─────────────────
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
